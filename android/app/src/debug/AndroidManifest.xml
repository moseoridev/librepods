<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".presentation.screens.apple.SettingsFixtureActivity"
            android:exported="true" android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.settingsfixture"
            android:label="LibrePods UI Fixture" />
        <!-- Comparison surface for native Manager captures; debug builds only. -->
        <activity android:name=".presentation.screens.apple.BudsManagerFixtureActivity"
            android:exported="true" android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.budsmanagerfixture"
            android:theme="@style/SettingsWindowTheme"
            android:label="Buds Manager Fixture" />
        <!-- adb-driven simulated AirPods; debug builds only. -->
        <receiver android:name=".simulation.SimulatedAirPodsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="me.kavishdevar.librepods.debug.SIMULATED_AIRPODS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
